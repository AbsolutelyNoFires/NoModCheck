<Project Sdk="Microsoft.NET.Sdk">
  <!-- Build: dotnet build -c Release -p:AuroraPatchDir=<folder containing AuroraPatch.exe> -->
  <PropertyGroup>
    <AssemblyName>NoModCheck</AssemblyName>
    <RootNamespace>NoModCheck</RootNamespace>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <LangVersion>7.3</LangVersion>
    <Version>1.0.0</Version>
    <AuroraPatchDir Condition="'$(AuroraPatchDir)' == ''">$(MSBuildThisFileDirectory)..\Aurora</AuroraPatchDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="AuroraPatch"><HintPath>$(AuroraPatchDir)\AuroraPatch.exe</HintPath><Private>false</Private></Reference>
    <PackageReference Include="Lib.Harmony" Version="2.2.2" ExcludeAssets="runtime" />
  </ItemGroup>
</Project>
